cabal-version: 3.0
-- SPDX-FileCopyrightText: 2026 Mika Tammi
-- SPDX-License-Identifier: BSD-3-Clause
--
-- The header sits below `cabal-version` because from spec 2.2 on that field
-- must be the file's first line, not even preceded by a comment.
name: furykernel-ane
version: 0.2.0.0
synopsis: The Apple Neural Engine target of FuryKernel
description:
  furykernel-ane lowers FuryKernel programs for the Apple Neural Engine: the
  Neural Engine's limits and the gate that holds a stage to them, and the
  emitters of Core ML programs and of the manifests runtimes read, their
  weight maps included. It emits programs only; runtimes compile them with
  Core ML.

homepage: https://github.com/infurer/furykernel-ane
bug-reports: https://github.com/infurer/furykernel-ane/issues
license: BSD-3-Clause
license-file: LICENSES/BSD-3-Clause.txt
author: Mika Tammi
maintainer: mikatammi@gmail.com
copyright: 2026 Mika Tammi
category: Compilers/Interpreters
build-type: Simple
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  test/golden/draft_step.json
  test/golden/tiny.mlmodel
  test/golden/tiny.txt

tested-with: ghc ==9.12.3

source-repository head
  type: git
  location: https://github.com/infurer/furykernel-ane.git

-- -Wmissing-home-modules: a module the .cabal file doesn't list stays out
-- of the source tarball Hackage gets, so the build refuses one.
common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wmissing-export-lists
    -Wmissing-home-modules

common extensions
  default-language: GHC2024
  default-extensions:
    OverloadedRecordDot
    OverloadedStrings
    StrictData

library
  import: warnings, extensions
  hs-source-dirs: src
  exposed-modules:
    FuryKernel.Ane
    FuryKernel.Ane.Blob
    FuryKernel.Ane.CoreML
    FuryKernel.Ane.Half
    FuryKernel.Ane.Host
    FuryKernel.Ane.Interp
    FuryKernel.Ane.Lower
    FuryKernel.Ane.Manifest
    FuryKernel.Ane.Mil
    FuryKernel.Ane.Package
    FuryKernel.Ane.Protobuf
    FuryKernel.Ane.Stage

  -- Bounds by the PVP, below each dependency's next major version, and
  -- stated once: the test suite shares the library's. base stays below
  -- 4.22 until a newer GHC than 9.12 is tested.
  build-depends:
    array >=0.5 && <0.6,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    furykernel >=0.2 && <0.3,
    text >=2.1 && <2.2,
    transformers >=0.6 && <0.7,

test-suite furykernel-ane-test
  import: warnings, extensions
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    Test.FuryKernel.Ane.BlobTest
    Test.FuryKernel.Ane.HalfTest
    Test.FuryKernel.Ane.LowerTest
    Test.FuryKernel.Ane.MilTest
    Test.FuryKernel.Ane.ProtobufTest
    Test.FuryKernel.Ane.Stages

  build-depends:
    base,
    bytestring,
    containers,
    directory,
    filepath,
    furykernel,
    furykernel-ane,
    hedgehog >=1.5 && <1.6,
    tasty >=1.5 && <1.6,
    tasty-hedgehog >=1.4 && <1.5,
    tasty-hunit >=0.10 && <0.11,
    text,
